ENVIRONMENT=local
DEBUG=true

POSTGRES_USER=kind_wardrobe
POSTGRES_PASSWORD=kind_wardrobe
POSTGRES_DB=kind_wardrobe
POSTGRES_PORT=5432

DATABASE_URL=postgresql+asyncpg://kind_wardrobe:kind_wardrobe@localhost:5432/kind_wardrobe
TEST_DATABASE_URL=postgresql+asyncpg://kind_wardrobe:kind_wardrobe@localhost:5432/kind_wardrobe_test

JWT_SECRET_KEY=change-me-to-a-long-random-string-at-least-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

CORS_ORIGINS=["http://localhost:5173"]
